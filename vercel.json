{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://155-138-217-184.sslip.io/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
