# Copy to .env and fill in. .env is gitignored.

# MARTA rail realtime key (free): https://itsmarta.com/developer-reg-rtt.aspx
MARTA_RAIL_API_KEY=

# Tiger Data (TimescaleDB + PostGIS). Leave empty to record to the local raw archive only.
# postgres://tsdbadmin:<password>@<service>.<project>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL=

# Optional overrides
# BACKTRACK_DATA_DIR=data          # relative paths are relative to the repo root
# BUS_POLL_SECONDS=15
# RAIL_POLL_SECONDS=20

# Gemini (server side only, never in client code). Parses typed clues, reads Find My
# screenshots and rewords the report email and call script around fixed tokens.
GEMINI_API_KEY=
# gemini-3.5-flash-lite answers in under a second; gemini-3.5-flash took 5 to 9 s (too slow)
GEMINI_MODEL=gemini-3.5-flash-lite
